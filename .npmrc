# Refuse to install on a Node or pnpm version this workspace does not support,
# rather than installing and failing later in a way that reads as a code bug.
# ADR 0005 pins Node 26 LTS (its 2026-10-29 amendment) and pnpm 11; `engines`
# in package.json states it. ⚠️ pnpm 11 does not read this line (#1597): it
# takes only auth, registry, TLS and proxy settings from `.npmrc`, and
# `engineStrict: true` in pnpm-workspace.yaml is what makes `engines` binding.
# This one is kept for a bare `npm`, which does read it.
engine-strict=true
