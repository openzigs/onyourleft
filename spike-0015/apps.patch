@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/**
+ * Spike 0013 (#433) — THROWAWAY, on a spike branch, never merged.
+ *
+ * The TypeScript half of "Godot beneath the WebView". This page is the WebView,
+ * made transparent; the world is drawn by Godot in a native view beneath it.
+ * Everything that decides WHERE anything is stays here, in the product's own
+ * code: `rideFrame` (the same function `realistic-harness.ts` renders through
+ * three.js) builds each frame, and this page ships
+ *
+ * - one STEP per 50 ms of simulation (20 Hz, #323's step), carrying the chase
+ *   camera's eye and target (`camera.ts` §`cameraRig`) and the three riders; and
+ * - one WINDOW of geometry every {@link WINDOW_EVERY_METRES} — the road, the
+ *   ground, the water, the bridges and every scenery placement of that frame —
+ *   as base64 over Capacitor's JSON bridge.
+ *
+ * Godot interpolates between steps on its own clock and draws. Query:
+ * `?shadows=1&msaa=2&scale=1&renderer=mobile|compat&delay=50&minutes=20`.
+ */
+
+import { cameraRig } from '../src/game/camera';
+import { verticalFieldOfViewDegrees } from '../src/game/camera';
+import type { SceneFrame } from '../src/game/port';
+import { INITIAL_QUALITY, worldRung } from '../src/game/quality';
+import { corridorOrigin, VIEW_AHEAD_METRES } from '../src/game/terrain';
+import { percentiles } from './realistic/config';
+import { rideFrame, RIDE_METRES_PER_SECOND } from './realistic/frame';
+import { realisticRoute } from './realistic/route';
+
+interface GodotWorldPlugin {
+  start(options: Record<string, unknown>): Promise<{ startedAt: number }>;
+  stop(): Promise<void>;
+  step(step: Record<string, unknown>): Promise<void>;
+  world(window: Record<string, unknown>): Promise<{ bytes: number; decodeMs: number }>;
+  reports(): Promise<{ lines: string }>;
+}
+
+/** Capacitor's own native bridge, injected into the page; no `@capacitor/core` in apps/web. */
+interface NativeBridge {
+  nativePromise(plugin: string, method: string, options?: Record<string, unknown>): Promise<unknown>;
+}
+const cap = (window as unknown as { Capacitor: NativeBridge }).Capacitor;
+const call = <T>(method: string, options: Record<string, unknown> = {}): Promise<T> =>
+  cap.nativePromise('GodotWorld', method, options) as Promise<T>;
+const GodotWorld: GodotWorldPlugin = {
+  start: (options) => call('start', options),
+  stop: () => call('stop'),
+  step: (step) => call('step', step),
+  world: (payload) => call('world', payload),
+  reports: () => call('reports'),
+};
+
+/** The same ride the three.js baseline page rides (`realistic-harness.ts`). */
+const START_METRES = 2_550;
+const LOOP_FROM_METRES = 300;
+const LOOP_METRES = 3_500;
+const STEP_SECONDS = 0.05;
+const WINDOW_EVERY_METRES = Number(new URLSearchParams(location.search).get('every') ?? '25');
+const REPORT_SECONDS = 30;
+
+const params = new URLSearchParams(location.search);
+const config = {
+  shadows: params.get('shadows') === '1',
+  msaa: Number(params.get('msaa') ?? '0'),
+  scale: Number(params.get('scale') ?? '1'),
+  renderer: params.get('renderer') ?? 'mobile',
+  delayMs: Number(params.get('delay') ?? '50'),
+  exposeGodot: params.get('exposeGodot') ?? '0',
+};
+/** `?quiet=1`: stop changing the DOM after 5 s, so uiautomator can reach an idle state. */
+const quiet = params.get('quiet') === '1';
+const quietAt = performance.now() + 5000;
+const frozen = (): boolean => quiet && performance.now() > quietAt;
+
+const logBox = document.getElementById('log') as HTMLElement;
+const lines: string[] = [];
+/** Every line, for the run script to read over DevTools (console forwarding is off). */
+const everything: string[] = [];
+(window as unknown as { __oylGodotPage: string[] }).__oylGodotPage = everything;
+function log(line: string): void {
+  console.log(line);
+  everything.push(line);
+  if (frozen()) return;
+  lines.push(line.slice(0, 400));
+  while (lines.length > 8) lines.shift();
+  logBox.textContent = lines.join('\n');
+}
+
+let taps = 0;
+(document.getElementById('tap') as HTMLElement).addEventListener('click', () => {
+  taps += 1;
+  (document.getElementById('taps') as HTMLElement).textContent = String(taps);
+  log(`OYL-GODOT-TAP ${JSON.stringify({ taps, at: Date.now() })}`);
+});
+
+function base64(bytes: Uint8Array): string {
+  let text = '';
+  const CHUNK = 0x8000;
+  for (let i = 0; i < bytes.length; i += CHUNK) {
+    text += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
+  }
+  return btoa(text);
+}
+
+function f32(array: Float32Array): string {
+  return base64(new Uint8Array(array.buffer, array.byteOffset, array.byteLength));
+}
+
+/** RGB triples to RGBA, which Godot's `to_color_array` reads. */
+function rgba(rgb: Float32Array): string {
+  const out = new Float32Array((rgb.length / 3) * 4);
+  for (let i = 0, j = 0; i < rgb.length; i += 3, j += 4) {
+    out[j] = rgb[i] as number;
+    out[j + 1] = rgb[i + 1] as number;
+    out[j + 2] = rgb[i + 2] as number;
+    out[j + 3] = 1;
+  }
+  return f32(out);
+}
+
+/**
+ * Indices with the winding reversed: three.js's front faces are anticlockwise
+ * and Godot's are clockwise. Copied, because the corridor's are borrowed.
+ */
+function godotIndices(indices: Uint32Array): string {
+  const out = new Int32Array(indices.length);
+  for (let i = 0; i + 2 < indices.length; i += 3) {
+    out[i] = indices[i] as number;
+    out[i + 1] = indices[i + 2] as number;
+    out[i + 2] = indices[i + 1] as number;
+  }
+  return base64(new Uint8Array(out.buffer));
+}
+
+function windowOf(frame: SceneFrame, aspect: number): Record<string, unknown> {
+  return {
+    fovDeg: verticalFieldOfViewDegrees(aspect),
+    viewEnd: VIEW_AHEAD_METRES,
+    sky: frame.world.skyColour,
+    ground: frame.world.groundColour,
+    horizon: frame.world.horizonColour,
+    sun: frame.world.sun,
+    roadVB64: f32(frame.corridor.vertices),
+    roadCB64: rgba(frame.corridor.colours),
+    roadIB64: godotIndices(frame.corridor.indices),
+    terrVB64: f32(frame.terrain.mesh.vertices),
+    terrNB64: f32(frame.terrain.mesh.normals),
+    terrCB64: rgba(frame.terrain.mesh.colours),
+    terrIB64: godotIndices(frame.terrain.mesh.indices),
+    waterVB64: f32(frame.water.surface.vertices),
+    waterIB64: godotIndices(frame.water.surface.indices),
+    bridges: frame.water.bridges.map((p) => [
+      p.x,
+      p.y,
+      p.z,
+      p.axisX,
+      p.axisY,
+      p.axisZ,
+      p.length,
+      p.width,
+      p.height,
+    ]),
+    scatter: frame.scatter.map((s) => [s.kind, s.x, s.y, s.z, s.rotation, s.scale, s.variant]),
+  };
+}
+
+async function run(): Promise<void> {
+  const profile = realisticRoute();
+  const origin = corridorOrigin(profile);
+  // The stylised world's top rung, held — what `?world=stylised&ladder=0` renders.
+  const rung = worldRung({ realistic: false, quality: { ...INITIAL_QUALITY, level: 0 } });
+  const startAsked = Date.now();
+  const started = await GodotWorld.start(config);
+  log(`OYL-GODOT-PAGE-START ${JSON.stringify({ config, startAsked, ...started })}`);
+
+  const t0 = performance.now();
+  let stepsSent = 0;
+  let windowAt = -Infinity;
+  let windows = 0;
+  const stepBuildMs: number[] = [];
+  const windowMs: number[] = [];
+  const windowBytes: number[] = [];
+  const decodeMs: number[] = [];
+  const rafMs: number[] = [];
+  let lastRaf = 0;
+  let reportAt = t0;
+  let hudAt = t0;
+  let inFlight = 0;
+  let maxInFlight = 0;
+
+  const distanceAt = (seconds: number): number =>
+    LOOP_FROM_METRES +
+    ((START_METRES - LOOP_FROM_METRES + seconds * RIDE_METRES_PER_SECOND) % LOOP_METRES);
+
+  const tick = (now: number): void => {
+    if (lastRaf > 0) rafMs.push(now - lastRaf);
+    lastRaf = now;
+    const due = Math.floor((now - t0) / 1000 / STEP_SECONDS);
+    while (stepsSent <= due) {
+      const seconds = stepsSent * STEP_SECONDS;
+      const distance = distanceAt(seconds);
+      const b0 = performance.now();
+      const frame = rideFrame({ profile, origin, distance, elapsed: seconds, rung });
+      const rig = cameraRig(frame.camera);
+      const step = {
+        seq: stepsSent,
+        d: distance,
+        eye: [rig.eye.x, rig.eye.y, rig.eye.z],
+        target: [rig.target.x, rig.target.y, rig.target.z],
+        markers: frame.markers.map((m) => [m.x, m.y, m.z, m.headingX, m.headingZ, m.lean]),
+        sentAt: performance.timeOrigin + performance.now(),
+      };
+      void GodotWorld.step(step);
+      stepBuildMs.push(performance.now() - b0);
+      if (Math.abs(distance - windowAt) >= WINDOW_EVERY_METRES) {
+        windowAt = distance;
+        const w0 = performance.now();
+        const payload = windowOf(frame, innerWidth / innerHeight);
+        const size = JSON.stringify(payload).length;
+        inFlight += 1;
+        maxInFlight = Math.max(maxInFlight, inFlight);
+        const sent = performance.now();
+        windowMs.push(sent - w0);
+        windowBytes.push(size);
+        windows += 1;
+        void GodotWorld.world(payload).then((reply) => {
+          inFlight -= 1;
+          decodeMs.push(reply.decodeMs);
+        });
+      }
+      stepsSent += 1;
+      if (now - hudAt > 250 && !frozen()) {
+        hudAt = now;
+        (document.getElementById('distance') as HTMLElement).textContent =
+          `${(distance / 1000).toFixed(2)} km`;
+        (document.getElementById('speed') as HTMLElement).textContent =
+          `${(RIDE_METRES_PER_SECOND * 3.6).toFixed(1)} km/h`;
+        (document.getElementById('steps') as HTMLElement).textContent = String(stepsSent);
+      }
+    }
+    if (now - reportAt >= REPORT_SECONDS * 1000) {
+      reportAt = now;
+      log(
+        `OYL-GODOT-PAGE ${JSON.stringify({
+          minute: (now - t0) / 60000,
+          stepsSent,
+          windows,
+          stepBuildMs: percentiles(stepBuildMs),
+          windowSerialiseMs: percentiles(windowMs),
+          windowJsonBytes: percentiles(windowBytes),
+          javaDecodeMs: percentiles(decodeMs),
+          webviewRafMs: percentiles(rafMs),
+          maxWindowsInFlight: maxInFlight,
+          taps,
+        })}`,
+      );
+      stepBuildMs.length = 0;
+      windowMs.length = 0;
+      windowBytes.length = 0;
+      decodeMs.length = 0;
+      rafMs.length = 0;
+      maxInFlight = 0;
+    }
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+
+  setInterval(() => {
+    void GodotWorld.reports().then((reply) => {
+      for (const line of reply.lines.split('\n')) {
+        if (line !== '') log(line);
+      }
+    });
+  }, 2000);
+}
+
+run().catch((error: unknown) => {
+  log(`OYL-GODOT-PAGE-ERROR ${String(error)}`);
+});
