index 0000000..685c3e8
--- /dev/null
+++ b/apps/web/browser/godot-realistic-harness.ts
@@ -0,0 +1,382 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/**
+ * Spike 0015 (#433) — THROWAWAY, on a spike branch, never merged.
+ *
+ * Spike 0014's page (`godot-harness.ts`), for the REALISTIC world. The page is
+ * the transparent WebView; Godot draws beneath it. Everything that decides
+ * WHERE anything is stays here, in the product's own code: `rideFrame` at the
+ * realistic top rung's budgets builds each frame, and this page ships
+ *
+ * - one STEP per 50 ms (20 Hz): `cameraRig`'s eye and target and the riders;
+ * - one WINDOW of geometry every {@link WINDOW_EVERY_METRES}: the road, the
+ *   ground, the water, the bridges and every scenery and structure placement;
+ * - and, in every window until Godot says it has them, the MODELS the product
+ *   builds from numbers rather than reads from a file: each structure kind's
+ *   geometry per surface (`realisticStructureGeometry`, the same triangles the
+ *   three.js realistic belts draw) and the realistic bicycle
+ *   (`realisticBicycle`, `realisticCrankset`).
+ *
+ * The committed CC0 FILES (the HDR sky, the surface photographs, the
+ * vegetation and rider `.glb`s, the impostor strips) are NOT sent: Godot loads
+ * them from its own imported copy, made by `spike-0015/scripts/convert.sh`.
+ *
+ * Query: `?delay=100&every=25&shadows=0&msaa=0&scale=1`.
+ */
+
+import type { BufferGeometry } from 'three';
+
+import { legBones } from '../src/game/bicycle';
+import { BUILDING_VARIANTS, isBuiltKind } from '../src/game/buildings';
+import { cameraRig, verticalFieldOfViewDegrees } from '../src/game/camera';
+import type { SceneFrame } from '../src/game/port';
+import { INITIAL_QUALITY, worldRung } from '../src/game/quality';
+import { REALISTIC_NEAR_MESHES } from '../src/game/realistic-budget';
+import { HORIZON_RADIUS_METRES, HORIZON_SEGMENTS } from '../src/game/landform';
+import {
+  drawnHorizonColour,
+  environmentIntensity,
+  REALISTIC_EXPOSURE,
+  REALISTIC_HORIZON_HAZE_SHARE,
+  ridgeLift,
+  skylineCrestFloor,
+} from '../src/game/realistic-light';
+import { STRUCTURE_KINDS } from '../src/game/scatter';
+import { corridorOrigin, VIEW_AHEAD_METRES, VIEW_BEHIND_METRES } from '../src/game/terrain';
+import {
+  lateralReachMetres,
+  realisticBicycle,
+  realisticCrankset,
+  realisticStructureGeometry,
+  realisticStructureSurfaces,
+  sceneryFitMetres,
+} from '../src/game/three-renderer';
+import { percentiles } from './realistic/config';
+import { rideFrame, RIDE_METRES_PER_SECOND } from './realistic/frame';
+import { realisticRoute } from './realistic/route';
+
+/**
+ * What `realistic-light.ts` reads off the HDR at load, computed once on the Mac
+ * from the committed `farm_field_2k.hdr` by `spike-0015/scripts/zz-sky.test.ts`
+ * (the product's own functions), so the Godot page need not load 6 MB of HDR
+ * into the WebView it is being compared against.
+ */
+const SKY = {
+  upward: 1.3704909410182435,
+  sunU: 0.603759765625,
+  skyline: [0.9239896749888397, 0.981741930964015, 1.0364261470167473] as const,
+};
+
+interface NativeBridge {
+  nativePromise(plugin: string, method: string, options?: Record<string, unknown>): Promise<unknown>;
+}
+const cap = (window as unknown as { Capacitor: NativeBridge }).Capacitor;
+const call = <T>(method: string, options: Record<string, unknown> = {}): Promise<T> =>
+  cap.nativePromise('GodotWorld', method, options) as Promise<T>;
+
+const START_METRES = 2_550;
+const LOOP_FROM_METRES = 300;
+const LOOP_METRES = 3_500;
+const STEP_SECONDS = 0.05;
+const REPORT_SECONDS = 30;
+
+const params = new URLSearchParams(location.search);
+const WINDOW_EVERY_METRES = Number(params.get('every') ?? '25');
+const config = {
+  world: 'realistic',
+  shadows: params.get('shadows') === '1',
+  msaa: Number(params.get('msaa') ?? '0'),
+  scale: Number(params.get('scale') ?? '1'),
+  renderer: params.get('renderer') ?? 'mobile',
+  delayMs: Number(params.get('delay') ?? '100'),
+  exposeGodot: params.get('exposeGodot') ?? '0',
+  exposure: REALISTIC_EXPOSURE,
+  sunU: SKY.sunU,
+  nearMeshes: REALISTIC_NEAR_MESHES,
+  fit: {
+    'tree-broadleaf': sceneryFitMetres('tree-broadleaf'),
+    'tree-conifer': sceneryFitMetres('tree-conifer'),
+    shrub: sceneryFitMetres('shrub'),
+    rock: sceneryFitMetres('rock'),
+  },
+  bikeLeg: legBones(0)
+    .slice(0, 2)
+    .reduce((sum, bone) => sum + bone.length, 0),
+  /** `lateralReachMetres` every 5 m from behind the rider to the view's end, for `inView`. */
+  reach: {
+    from: -VIEW_BEHIND_METRES,
+    step: 5,
+    values: Array.from(
+      { length: Math.floor((VIEW_AHEAD_METRES + VIEW_BEHIND_METRES) / 5) + 1 },
+      (_, i) => lateralReachMetres(-VIEW_BEHIND_METRES + i * 5),
+    ),
+  },
+  viewAhead: VIEW_AHEAD_METRES,
+  viewBehind: VIEW_BEHIND_METRES,
+};
+const quiet = params.get('quiet') === '1';
+const quietAt = performance.now() + 5000;
+const frozen = (): boolean => quiet && performance.now() > quietAt;
+
+const logBox = document.getElementById('log') as HTMLElement;
+const lines: string[] = [];
+const everything: string[] = [];
+(window as unknown as { __oylGodotPage: string[] }).__oylGodotPage = everything;
+let modelsTaken = false;
+function log(line: string): void {
+  console.log(line);
+  everything.push(line);
+  if (line.startsWith('OYL-GODOT-MODELS-OK')) modelsTaken = true;
+  if (frozen()) return;
+  lines.push(line.slice(0, 400));
+  while (lines.length > 8) lines.shift();
+  logBox.textContent = lines.join('\n');
+}
+
+let taps = 0;
+(document.getElementById('tap') as HTMLElement).addEventListener('click', () => {
+  taps += 1;
+  (document.getElementById('taps') as HTMLElement).textContent = String(taps);
+  log(`OYL-GODOT-TAP ${JSON.stringify({ taps, at: Date.now() })}`);
+});
+
+function base64(bytes: Uint8Array): string {
+  let text = '';
+  const CHUNK = 0x8000;
+  for (let i = 0; i < bytes.length; i += CHUNK) {
+    text += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
+  }
+  return btoa(text);
+}
+const f32 = (array: Float32Array): string =>
+  base64(new Uint8Array(array.buffer, array.byteOffset, array.byteLength));
+function rgba(rgb: ArrayLike<number>): string {
+  const out = new Float32Array((rgb.length / 3) * 4);
+  for (let i = 0, j = 0; i < rgb.length; i += 3, j += 4) {
+    out[j] = rgb[i] as number;
+    out[j + 1] = rgb[i + 1] as number;
+    out[j + 2] = rgb[i + 2] as number;
+    out[j + 3] = 1;
+  }
+  return f32(out);
+}
+/** three.js's front faces are anticlockwise and Godot's clockwise. */
+function godotIndices(indices: ArrayLike<number>): string {
+  const out = new Int32Array(indices.length);
+  for (let i = 0; i + 2 < indices.length; i += 3) {
+    out[i] = indices[i] as number;
+    out[i + 1] = indices[i + 2] as number;
+    out[i + 2] = indices[i + 1] as number;
+  }
+  return base64(new Uint8Array(out.buffer));
+}
+
+/** A geometry's arrays for Godot: positions, normals, uvs, colours, indices. */
+function geometryFields(prefix: string, geometry: BufferGeometry, into: Record<string, unknown>): void {
+  const position = geometry.getAttribute('position');
+  const normal = geometry.getAttribute('normal');
+  const uv = geometry.getAttribute('uv');
+  const colour = geometry.getAttribute('color');
+  into[`${prefix}PB64`] = f32(Float32Array.from(position.array as ArrayLike<number>));
+  if (normal !== undefined) into[`${prefix}NB64`] = f32(Float32Array.from(normal.array as ArrayLike<number>));
+  if (uv !== undefined) into[`${prefix}UB64`] = f32(Float32Array.from(uv.array as ArrayLike<number>));
+  if (colour !== undefined) {
+    if (colour.itemSize === 3) into[`${prefix}CB64`] = rgba(colour.array as ArrayLike<number>);
+    else into[`${prefix}CB64`] = f32(Float32Array.from(colour.array as ArrayLike<number>));
+  }
+  const index = geometry.getIndex();
+  const order = index !== null ? (index.array as ArrayLike<number>) : Array.from({ length: position.count }, (_, i) => i);
+  into[`${prefix}IB64`] = godotIndices(order);
+}
+
+/** The models the product builds from numbers, once: structures per surface, and the bicycle. */
+function modelFields(): Record<string, unknown> {
+  const out: Record<string, unknown> = {};
+  const parts: { i: number; kind: string; variant: number; surface: string }[] = [];
+  let i = 0;
+  for (const kind of STRUCTURE_KINDS) {
+    const variants = isBuiltKind(kind) ? BUILDING_VARIANTS : 1;
+    for (const surface of realisticStructureSurfaces(kind)) {
+      for (let variant = 0; variant < variants; variant += 1) {
+        const geometry = realisticStructureGeometry(kind, surface, variant);
+        if (geometry === undefined) continue;
+        geometryFields(`s${i}`, geometry, out);
+        parts.push({ i, kind, variant, surface });
+        geometry.dispose();
+        i += 1;
+      }
+    }
+  }
+  const bike = realisticBicycle();
+  const crank = realisticCrankset();
+  geometryFields('bikeFrame', bike.frame, out);
+  geometryFields('bikeRubber', bike.rubber, out);
+  geometryFields('bikeMetal', bike.metal, out);
+  geometryFields('bikeCrank', crank, out);
+  out['structureParts'] = parts;
+  return out;
+}
+
+function windowOf(frame: SceneFrame, aspect: number, withModels: boolean): Record<string, unknown> {
+  const intensity = environmentIntensity(frame.world.sun.ambient, SKY.upward);
+  const horizon = drawnHorizonColour(SKY.skyline, intensity);
+  return {
+    fovDeg: verticalFieldOfViewDegrees(aspect),
+    viewEnd: VIEW_AHEAD_METRES,
+    fogDensity: frame.world.fogDensity,
+    ground: frame.world.groundColour,
+    // The far hills (three-renderer.ts §HorizonRing), with #544's lift, as the realistic path builds them.
+    horizonRing: {
+      segments: HORIZON_SEGMENTS,
+      radius: HORIZON_RADIUS_METRES,
+      base: frame.terrain.horizon.base,
+      foot: frame.terrain.horizon.foot,
+      tops: Array.from(frame.terrain.horizon.tops),
+      lift: ridgeLift(
+        frame.terrain.horizon.tops,
+        skylineCrestFloor(cameraRig(frame.camera).eye.y, HORIZON_RADIUS_METRES),
+      ),
+      hazeShare: REALISTIC_HORIZON_HAZE_SHARE,
+    },
+    horizonLinear: horizon,
+    envIntensity: intensity,
+    sun: frame.world.sun,
+    roadVB64: f32(frame.corridor.vertices),
+    roadCB64: rgba(frame.corridor.colours),
+    roadIB64: godotIndices(frame.corridor.indices),
+    terrVB64: f32(frame.terrain.mesh.vertices),
+    terrNB64: f32(frame.terrain.mesh.normals),
+    terrCB64: rgba(frame.terrain.mesh.colours),
+    terrIB64: godotIndices(frame.terrain.mesh.indices),
+    waterVB64: f32(frame.water.surface.vertices),
+    waterIB64: godotIndices(frame.water.surface.indices),
+    bridges: frame.water.bridges.map((p) => [
+      p.x,
+      p.y,
+      p.z,
+      p.axisX,
+      p.axisY,
+      p.axisZ,
+      p.length,
+      p.width,
+      p.height,
+    ]),
+    scatter: frame.scatter.map((s) => [s.kind, s.x, s.y, s.z, s.rotation, s.scale, s.variant]),
+    ...(withModels ? { models: true, ...modelFields() } : {}),
+  };
+}
+
+async function run(): Promise<void> {
+  const profile = realisticRoute();
+  const origin = corridorOrigin(profile);
+  // The realistic top rung, held — what `realistic.html?world=realistic&ladder=0` draws.
+  const rung = worldRung({ realistic: true, quality: { ...INITIAL_QUALITY, level: 0 } });
+  const startAsked = Date.now();
+  const started = await call<{ startedAt: number }>('start', config);
+  log(`OYL-GODOT-PAGE-START ${JSON.stringify({ config: { ...config, reach: undefined }, startAsked, ...started })}`);
+
+  const t0 = performance.now();
+  let stepsSent = 0;
+  let windowAt = -Infinity;
+  let windows = 0;
+  const stepBuildMs: number[] = [];
+  const windowMs: number[] = [];
+  const windowBytes: number[] = [];
+  const decodeMs: number[] = [];
+  const rafMs: number[] = [];
+  let lastRaf = 0;
+  let reportAt = t0;
+  let hudAt = t0;
+  let maxInFlight = 0;
+  let inFlight = 0;
+
+  const distanceAt = (seconds: number): number =>
+    LOOP_FROM_METRES +
+    ((START_METRES - LOOP_FROM_METRES + seconds * RIDE_METRES_PER_SECOND) % LOOP_METRES);
+
+  const tick = (now: number): void => {
+    if (lastRaf > 0) rafMs.push(now - lastRaf);
+    lastRaf = now;
+    const due = Math.floor((now - t0) / 1000 / STEP_SECONDS);
+    while (stepsSent <= due) {
+      const seconds = stepsSent * STEP_SECONDS;
+      const distance = distanceAt(seconds);
+      const b0 = performance.now();
+      const frame = rideFrame({ profile, origin, distance, elapsed: seconds, rung });
+      const rig = cameraRig(frame.camera);
+      const step = {
+        seq: stepsSent,
+        d: distance,
+        eye: [rig.eye.x, rig.eye.y, rig.eye.z],
+        target: [rig.target.x, rig.target.y, rig.target.z],
+        pose: [frame.camera.x, frame.camera.z, frame.camera.headingX, frame.camera.headingZ],
+        markers: frame.markers.map((m) => [m.x, m.y, m.z, m.headingX, m.headingZ, m.lean, m.kind]),
+        sentAt: performance.timeOrigin + performance.now(),
+      };
+      void call('step', step);
+      stepBuildMs.push(performance.now() - b0);
+      if (Math.abs(distance - windowAt) >= WINDOW_EVERY_METRES) {
+        windowAt = distance;
+        const w0 = performance.now();
+        const payload = windowOf(frame, innerWidth / innerHeight, !modelsTaken);
+        const size = JSON.stringify(payload).length;
+        const sent = performance.now();
+        windowMs.push(sent - w0);
+        windowBytes.push(size);
+        windows += 1;
+        inFlight += 1;
+        maxInFlight = Math.max(maxInFlight, inFlight);
+        void call<{ bytes: number; decodeMs: number }>('world', payload).then((reply) => {
+          inFlight -= 1;
+          decodeMs.push(reply.decodeMs);
+        });
+      }
+      stepsSent += 1;
+      if (now - hudAt > 250 && !frozen()) {
+        hudAt = now;
+        (document.getElementById('distance') as HTMLElement).textContent =
+          `${(distance / 1000).toFixed(2)} km`;
+        (document.getElementById('speed') as HTMLElement).textContent =
+          `${(RIDE_METRES_PER_SECOND * 3.6).toFixed(1)} km/h`;
+        (document.getElementById('steps') as HTMLElement).textContent = String(stepsSent);
+      }
+    }
+    if (now - reportAt >= REPORT_SECONDS * 1000) {
+      reportAt = now;
+      log(
+        `OYL-GODOT-PAGE ${JSON.stringify({
+          minute: (now - t0) / 60000,
+          stepsSent,
+          windows,
+          stepBuildMs: percentiles(stepBuildMs),
+          windowSerialiseMs: percentiles(windowMs),
+          windowJsonBytes: percentiles(windowBytes),
+          javaDecodeMs: percentiles(decodeMs),
+          webviewRafMs: percentiles(rafMs),
+          maxWindowsInFlight: maxInFlight,
+          taps,
+        })}`,
+      );
+      stepBuildMs.length = 0;
+      windowMs.length = 0;
+      windowBytes.length = 0;
+      decodeMs.length = 0;
+      rafMs.length = 0;
+      maxInFlight = 0;
+    }
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+
+  setInterval(() => {
+    void call<{ lines: string }>('reports').then((reply) => {
+      for (const line of reply.lines.split('\n')) {
+        if (line !== '') log(line);
+      }
+    });
+  }, 2000);
+}
+
+run().catch((error: unknown) => {
+  log(`OYL-GODOT-PAGE-ERROR ${String(error)}`);
+});
