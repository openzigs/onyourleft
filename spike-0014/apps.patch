diff --git a/apps/mobile/android/app/src/main/java/dev/openzigs/onyourleft/WorldBridgePlugin.java b/apps/mobile/android/app/src/main/java/dev/openzigs/onyourleft/WorldBridgePlugin.java
new file mode 100644
index 0000000..9e8759e
--- /dev/null
+++ b/apps/mobile/android/app/src/main/java/dev/openzigs/onyourleft/WorldBridgePlugin.java
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package dev.openzigs.onyourleft;
+
+import androidx.annotation.NonNull;
+
+import org.godotengine.godot.Godot;
+import org.godotengine.godot.plugin.GodotPlugin;
+import org.godotengine.godot.plugin.UsedByGodot;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Spike 0013 (#433), throwaway. The Godot side of the bridge: what GDScript polls once a frame.
+ *
+ * <p>The Capacitor plugin ({@link GodotWorldPlugin}) writes here from the bridge's thread; the
+ * Godot render thread reads from GDScript through {@code Engine.get_singleton("WorldBridge")}.
+ * Everything is guarded by one lock, and every read TAKES what it returns, so nothing is read
+ * twice.
+ */
+public class WorldBridgePlugin extends GodotPlugin {
+
+    private static final Object LOCK = new Object();
+    private static StringBuilder steps = new StringBuilder();
+    private static String worldMeta = null;
+    private static Map<String, byte[]> worldBytes = new HashMap<>();
+    private static Map<String, byte[]> pendingBytes = new HashMap<>();
+    private static String config = "";
+    private static final java.util.ArrayDeque<String> reports = new java.util.ArrayDeque<>();
+
+    public WorldBridgePlugin(Godot godot) {
+        super(godot);
+    }
+
+    @NonNull
+    @Override
+    public String getPluginName() {
+        return "WorldBridge";
+    }
+
+    // ---- written by the Capacitor side ----
+
+    static void setConfig(String json) {
+        synchronized (LOCK) {
+            config = json;
+        }
+    }
+
+    /** One step, as a JSON object with recvAt already stamped. */
+    static void putStep(String json) {
+        synchronized (LOCK) {
+            if (steps.length() > 0) steps.append(',');
+            steps.append(json);
+        }
+    }
+
+    static void putWorld(String meta, Map<String, byte[]> bytes) {
+        synchronized (LOCK) {
+            worldMeta = meta;
+            pendingBytes = bytes;
+        }
+    }
+
+    static String takeReports() {
+        synchronized (LOCK) {
+            StringBuilder out = new StringBuilder();
+            while (!reports.isEmpty()) {
+                if (out.length() > 0) out.append('\n');
+                out.append(reports.pollFirst());
+            }
+            return out.toString();
+        }
+    }
+
+    // ---- read by GDScript ----
+
+    @UsedByGodot
+    public String config() {
+        synchronized (LOCK) {
+            return config;
+        }
+    }
+
+    @UsedByGodot
+    public String takeSteps() {
+        synchronized (LOCK) {
+            if (steps.length() == 0) return "";
+            String out = "[" + steps + "]";
+            steps = new StringBuilder();
+            return out;
+        }
+    }
+
+    @UsedByGodot
+    public boolean hasWorld() {
+        synchronized (LOCK) {
+            return worldMeta != null;
+        }
+    }
+
+    @UsedByGodot
+    public String takeWorldMeta() {
+        synchronized (LOCK) {
+            String out = worldMeta;
+            worldMeta = null;
+            worldBytes = pendingBytes;
+            pendingBytes = new HashMap<>();
+            return out == null ? "" : out;
+        }
+    }
+
+    @UsedByGodot
+    public byte[] worldBytes(String name) {
+        synchronized (LOCK) {
+            byte[] out = worldBytes.get(name);
+            return out == null ? new byte[0] : out;
+        }
+    }
+
+    @UsedByGodot
+    public void report(String line) {
+        synchronized (LOCK) {
+            reports.addLast(line);
+            while (reports.size() > 64) reports.pollFirst();
+        }
+    }
+}
