@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package dev.openzigs.onyourleft;
+
+import android.util.Base64;
+
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+
+import org.json.JSONObject;
+
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+
+/**
+ * Spike 0013 (#433), throwaway. The TypeScript side of the bridge: Capacitor's asynchronous
+ * JSON calls, forwarded to {@link WorldBridgePlugin}.
+ */
+@CapacitorPlugin(name = "GodotWorld")
+public class GodotWorldPlugin extends Plugin {
+
+    @PluginMethod
+    public void start(PluginCall call) {
+        WorldBridgePlugin.setConfig(call.getData().toString());
+        MainActivity activity = (MainActivity) getActivity();
+        activity.runOnUiThread(() -> {
+            long at = activity.startGodot(call.getData());
+            JSObject reply = new JSObject();
+            reply.put("startedAt", at);
+            call.resolve(reply);
+        });
+    }
+
+    @PluginMethod
+    public void stop(PluginCall call) {
+        MainActivity activity = (MainActivity) getActivity();
+        activity.runOnUiThread(() -> {
+            activity.stopGodot();
+            call.resolve();
+        });
+    }
+
+    /** One simulation step. Resolved at once: the page does not await it. */
+    @PluginMethod
+    public void step(PluginCall call) {
+        double recvAt = System.currentTimeMillis();
+        JSObject data = call.getData();
+        try {
+            data.put("recvAt", recvAt);
+        } catch (Exception ignored) {
+        }
+        WorldBridgePlugin.putStep(data.toString());
+        call.resolve();
+    }
+
+    /** A window of world geometry. Every string field ending in "B64" is decoded to bytes. */
+    @PluginMethod
+    public void world(PluginCall call) {
+        long t0 = System.nanoTime();
+        JSObject data = call.getData();
+        Map<String, byte[]> bytes = new HashMap<>();
+        JSONObject meta = new JSONObject();
+        int total = 0;
+        try {
+            Iterator<String> keys = data.keys();
+            while (keys.hasNext()) {
+                String key = keys.next();
+                if (key.endsWith("B64")) {
+                    byte[] decoded = Base64.decode(data.getString(key), Base64.DEFAULT);
+                    total += decoded.length;
+                    bytes.put(key.substring(0, key.length() - 3), decoded);
+                } else {
+                    meta.put(key, data.get(key));
+                }
+            }
+        } catch (Exception e) {
+            call.reject(e.toString());
+            return;
+        }
+        WorldBridgePlugin.putWorld(meta.toString(), bytes);
+        JSObject reply = new JSObject();
+        reply.put("bytes", total);
+        reply.put("decodeMs", (System.nanoTime() - t0) / 1e6);
+        call.resolve(reply);
+    }
+
+    /** What GDScript has reported since the last call, one line each. */
+    @PluginMethod
+    public void reports(PluginCall call) {
+        JSObject reply = new JSObject();
+        reply.put("lines", WorldBridgePlugin.takeReports());
+        call.resolve(reply);
+    }
+}
