node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
# The halves of the nightly coverage run, which `test:coverage:merge` reads (#2285).
coverage-blobs/

# Python's bytecode, written beside a module a script imports: the realistic
# pipeline's Blender scripts import siblings (#900). `check-repo-rules.sh`
# prunes it for the same reason.
__pycache__/

# Git worktrees of other branches, created by the delivery workflows. Git
# already declines to stage a nested worktree — it sees the `.git` file and
# stops — so `git add -A` was safe without this line. It is here so the intent
# is written down rather than resting on a git behaviour nobody stated, and so
# that a `git add` of a path inside it has to be forced. Never force it: that
# commits another branch's whole tree (#148).
#
# One file in it is committed: `.claude/delivery.md`, the delivery pipeline's
# constraints, which every dispatched agent reads from its own worktree and so
# has to be in the tree. The directory is ignored by its contents rather than
# by its name, because git cannot un-ignore a file inside an ignored directory.
.claude/*
!.claude/delivery.md

# Signing material (#95, #1761): the names `scripts/check-repo-rules.sh`
# REL001 refuses, so `git add` passes over a key before that rule ever has to
# report one. Keys and certificates live in repository secrets. Never force one
# past this: a pushed commit is permanent whatever a later commit deletes.
*.jks
*.keystore
*.p12
*.pfx
*.key
*.mobileprovision
*.cer
keystore.properties
release-key.*
upload-key.*

# The home deploy's record of what it deployed (#52): a file on the box.
apps/instance/deploy/home/.deployed
# The home deploy's secret files (#2146): the Discord bot token. On the box only.
apps/instance/deploy/home/secrets/

# The group-ride harness's scores (#3309): numbers and seeds only, written by
# each run of `pnpm run group-ride:harness` for comparing two runs on one
# machine. Not a baseline: the scoring tests in `pnpm run test` are the gate.
apps/web/tools/group-ride-harness/results/
