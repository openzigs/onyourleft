<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Since #672 the window behind the WebView is the page's canvas, per palette
      (colors.xml and values-night/colors.xml), not AppCompat's own background.
      ⚠️ #2127: AppCompat sets the window's background in super.onCreate, from
      the launch theme, before BridgeActivity switches to this one, so the
      launch theme's android:windowBackground is the one a rider sees. This
      one applies only to a window this theme creates.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/oyl_canvas</item>
        <!--
          #2127: read only below Android 12. The splash plugin installs the
          splash from its load(), after BridgeActivity has switched to this
          theme, and the compat library reads the splash's colour and logo
          from the theme it finds then. Android 12 and later read them from
          the launch theme below, through the manifest.
        -->
        <item name="windowSplashScreenBackground">@color/oyl_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/oyl_splash_icon_compat</item>
    </style>

    <!--
      The launch window (#672): on Android 12 and later the system splash screen,
      whose background is the page's canvas rather than the device's default; on
      Android 7 to 11 the launch background colors.xml names per palette.
      Since #2050 the splash-screen plugin holds it until the page has painted,
      and postSplashScreenTheme is the theme the window takes when it lets go.

      #2127, so every launch shows the logo on the canvas and nothing else:
      - windowSplashScreenAnimatedIcon names the launcher icon. Left unset,
        core-splashscreen's API 31 theme points the platform at an attribute
        with no value, and below 31 its default is Android's generic icon.
      - windowSplashScreenBehavior icon_preferred (API 33+) asks for the icon
        where Android would otherwise choose a plain-colour splash.
      - android:windowBackground, not android:background (a view attribute,
        which painted no window): AppCompat paints the app's window from this
        theme in super.onCreate, before BridgeActivity switches theme, and
        on API 31+ it was Theme.DeviceDefault.DayNight's, near-black in the
        device's dark mode. drawable/ and drawable-v31/oyl_launch_window.xml
        are the canvas with the logo where the splash draws it.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/oyl_launch_window</item>
        <item name="windowSplashScreenBackground">@color/oyl_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
