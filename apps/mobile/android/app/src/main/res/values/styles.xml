<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Since #672 the window behind the WebView is the page's canvas, per palette
      (colors.xml and values-night/colors.xml), not AppCompat's own background.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/oyl_canvas</item>
    </style>

    <!--
      The launch window (#672): on Android 12 and later the system splash screen,
      whose background is the page's canvas rather than the device's default; on
      Android 7 to 11 the launch background colors.xml names per palette.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/oyl_launch_background</item>
        <item name="windowSplashScreenBackground">@color/oyl_canvas</item>
    </style>
</resources>
