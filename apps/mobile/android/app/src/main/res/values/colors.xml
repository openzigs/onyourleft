<!--
  The colour the app is before its page paints (#672): the launch window, the
  window behind the WebView, and the WebView's own background.

  It is the canvas of the palette the page starts in, and since #992 the page
  starts dark whatever the device's own mode, so this is the dark canvas,
  apps/web/src/design/tokens.ts DARK_COLOUR_TOKENS canvas, even on a device in
  light mode (#999): a white frame before a dark page is the flash #672 removed.
  values-night/colors.xml is the device's dark mode.
  apps/mobile/src/android/night-colours.test.ts holds both to the palette
  theme-selection.ts DEFAULT_THEME_CHOICE comes to.
-->
<resources>
    <color name="oyl_canvas">#101215</color>
    <!--
      The launch window's canvas: the canvas itself rather than Capacitor's
      splash picture, which is white (#999). Since #2127 it is the first layer
      of drawable/oyl_launch_window.xml, the launch theme's window background
      on every Android version.
    -->
    <drawable name="oyl_launch_background">@color/oyl_canvas</drawable>
    <!--
      The Android 12+ splash icon (#2052), named per palette as the canvas is:
      the mark the brand pipeline composes for the splash
      (apps/web/tools/brand/derive_brand.py, kind "splash"), drawn on
      oyl_canvas. One picture serves both palettes while both start dark.
      apps/mobile/src/android/splash-icon.test.ts resolves it in each.
    -->
    <drawable name="oyl_splash_icon">@drawable/oyl_splash_mark</drawable>
</resources>
