<!--
  The launch window below Android 12 (#2127): the canvas, per palette, with
  the launcher icon at the size the compat splash library draws it (192 dp
  visible), so the hand-over to its splash view does not jump. It is also
  the app window's background, which AppCompat takes from the launch theme.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/oyl_launch_background" />
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="192dp"
        android:height="192dp" />
</layer-list>
