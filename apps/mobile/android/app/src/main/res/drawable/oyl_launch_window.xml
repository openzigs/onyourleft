<!--
  The launch window below Android 12 (#2127), and so the splash itself there:
  the system's preview window, which the splash plugin holds until the page
  has painted. With launchFadeOutDuration 0 the plugin registers no exit
  listener, so core-splashscreen never builds a splash view of its own to
  hand over to. The canvas, per palette, with the launcher icon at 192 dp,
  the size the compat library would draw it. AppCompat also takes it as the
  app window's background in super.onCreate, until MainActivity resets that
  to the canvas.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/oyl_launch_background" />
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="192dp"
        android:height="192dp" />
</layer-list>
