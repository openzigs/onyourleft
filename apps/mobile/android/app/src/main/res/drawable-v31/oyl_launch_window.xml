<!--
  The app window's first background on Android 12 and later (#2127).
  AppCompat takes it from the launch theme in super.onCreate, before
  BridgeActivity switches theme, so a frame of the bare window before
  MainActivity resets it to the canvas is the splash, and never
  Theme.DeviceDefault's near-black or white. It is the canvas, per palette,
  with the launcher icon where the system splash draws an adaptive icon on
  a different-coloured background (160 dp visible).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/oyl_launch_background" />
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="160dp"
        android:height="160dp" />
</layer-list>
