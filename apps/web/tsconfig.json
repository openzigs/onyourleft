{
  // The browser client may use the DOM. It is the only half of the workspace
  // that may: the licence boundary and the platform boundary are the same line
  // (docs/architecture.md), and `apps/` is the side that gets a platform.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // The browser gate (#63). Typechecked with the rest of the client rather
    // than left out: it imports the real map adapter, so a change that breaks
    // the adapter's signature has to break here too.
    "browser/**/*.ts",
    "vite.config.ts",
    "vite.browser.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
