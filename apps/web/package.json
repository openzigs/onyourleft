{
  "name": "@onyourleft/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Browser client — the Phase 1 product.",
  "scripts": {
    "dev": "vite",
    "wordmark:generate": "node --import ./tools/ts-extensionless-resolve.mjs tools/brand/game-wordmark.ts",
    "fonts:subset": "node --import ./tools/ts-extensionless-resolve.mjs tools/fonts/subset-fonts.ts",
    "glyphs:generate": "node --import ./tools/ts-extensionless-resolve.mjs tools/glyphs/generate-glyphs.ts",
    "realistic:fetch": "node --import ./tools/ts-extensionless-resolve.mjs tools/realistic/fetch-assets.ts",
    "realistic:process": "node --import ./tools/ts-extensionless-resolve.mjs tools/realistic/process-assets.ts",
    "realistic:stage": "node --import ./tools/ts-extensionless-resolve.mjs tools/realistic/stage-into-apk.ts",
    "build": "tsc --noEmit --project tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:browser": "vite build && vite build --config vite.browser.config.ts && playwright test --project chromium --workers 3 --global-timeout 640000; chromium=$?; playwright test --project game --global-timeout 200000; game=$?; [ $chromium -eq 0 ] && [ $game -eq 0 ]",
    "test:browser:nightly": "vite build && vite build --config vite.browser.config.ts && playwright test --project nightly --workers 1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@onyourleft/domain": "workspace:*",
    "@onyourleft/fit": "workspace:*",
    "@onyourleft/mobile": "workspace:*",
    "@onyourleft/physics": "workspace:*",
    "@onyourleft/protocol": "workspace:*",
    "@onyourleft/sensors": "workspace:*",
    "@onyourleft/store": "workspace:*",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "jsqr": "1.4.0",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.11.2",
    "motion": "13.5.1",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.185.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "fit-file-parser": "6.1.2",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
