      "sha256": "37fb98f704f257c497d4cf4fcda32febc6129ae5f0ea30f7a526c723f09ce2ba",
      "what": "the owner's full logo (the shield, the rider, the arrow, the ON YOUR LEFT wordmark and the white sticker outline) on a flat green screen"
    }
  ],
  "families": {
    "icon": {
      "source": "apps/web/tools/brand/sources/gemini-assets-v3.jpeg",
      "modified": "the icon mark (the shield with the rider and the arrow) cut out of the sheet's blue panel, its baked rounded corners and light background replaced by the panel's own flat blue so that a launcher's mask is the only rounding, and set on that flat blue at a size, or on a transparent layer inside a safe zone, then resized"
    },
    "wordmark": {
      "source": "apps/web/tools/brand/sources/gemini-assets-v2.jpeg",
      "modified": "the ON YOUR LEFT wordmark cut out of the sheet by colour from the checkerboard painted into its pixels, its letters set in one flat navy (or, for the dark palette, in the app's dark ink #e4ebe9) and its arrow kept, then resized"
    },
    "logo": {
      "source": "apps/web/tools/brand/sources/gemini-logo-green.jpeg",
      "modified": "the full logo taken off its green screen by a chroma key (alpha from how much greener than red and blue a pixel is), the green spill taken out of its edges, cropped to what it covers, and for the light palette laid on a soft navy shadow of its own outline so the white sticker outline reads on a white canvas, then resized"
    }
  },
