{
  "openapi": "3.1.0",
  "info": {
    "title": "On Your Left instance",
    "version": "1",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the instance is answering, and which build it is.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "commit"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          },
          "405": {
            "$ref": "#/components/responses/method_not_allowed"
          },
          "413": {
            "$ref": "#/components/responses/payload_too_large"
          },
          "429": {
            "$ref": "#/components/responses/rate_limited"
          },
          "500": {
            "$ref": "#/components/responses/internal"
          }
        }
      }
    },
    "/licences/third-party.txt": {
      "get": {
        "operationId": "getThirdPartyNotices",
        "summary": "The licence and notice of every third-party package this instance includes, generated and gated by `check:notices`.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          },
          "405": {
            "$ref": "#/components/responses/method_not_allowed"
          },
          "413": {
            "$ref": "#/components/responses/payload_too_large"
          },
          "429": {
            "$ref": "#/components/responses/rate_limited"
          },
          "500": {
            "$ref": "#/components/responses/internal"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getSpecification",
        "summary": "This specification.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "An OpenAPI 3.1 document."
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          },
          "405": {
            "$ref": "#/components/responses/method_not_allowed"
          },
          "413": {
            "$ref": "#/components/responses/payload_too_large"
          },
          "429": {
            "$ref": "#/components/responses/rate_limited"
          },
          "500": {
            "$ref": "#/components/responses/internal"
          }
        }
      }
    },
    "/source": {
      "get": {
        "operationId": "getSource",
        "summary": "Where the exact source of the running build is — the offer AGPL-3.0 §13 requires (ADR 0036 D-6).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "licence": {
                      "type": "string",
                      "enum": [
                        "AGPL-3.0-or-later"
                      ]
                    }
                  },
                  "required": [
                    "url",
                    "commit",
                    "licence"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/not_found"
          },
          "405": {
            "$ref": "#/components/responses/method_not_allowed"
          },
          "413": {
            "$ref": "#/components/responses/payload_too_large"
          },
          "429": {
            "$ref": "#/components/responses/rate_limited"
          },
          "500": {
            "$ref": "#/components/responses/internal"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation_failed",
                  "unauthenticated",
                  "not_found",
                  "method_not_allowed",
                  "payload_too_large",
                  "rate_limited",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "problem": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "problem"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "validation_failed": {
        "description": "`validation_failed` (400), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "unauthenticated": {
        "description": "`unauthenticated` (401), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "not_found": {
        "description": "`not_found` (404), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "method_not_allowed": {
        "description": "`method_not_allowed` (405), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "payload_too_large": {
        "description": "`payload_too_large` (413), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "rate_limited": {
        "description": "`rate_limited` (429), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "internal": {
        "description": "`internal` (500), in the one error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
