# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to `.env` beside compose.yaml and fill in (#807). `.env` is ignored by
# git; this file is the template. Every name here is also in the repository's
# own .env.example, with what it means.

# The image deploy.sh built (it sets this itself; for a hand-run compose, the
# tag you built).
OYL_INSTANCE_IMAGE=onyourleft-instance:local

# The tunnel's public hostname, as a rider's app will use it.
OYL_INSTANCE_ORIGIN=https://rides.example.org

# `open` while the riders you expect sign up, then `closed`.
OYL_INSTANCE_REGISTRATION=closed

# Empty: one room worker per core.
OYL_INSTANCE_ROOM_WORKERS=

# `off` (the default, ruling Q16) or `on`. On a home connection whose UPLOAD
# is the limit, `on` roughly doubles the rooms it carries at twice the memory
# (docs/self-hosting/home-machine.md, "Compression").
OYL_INSTANCE_WS_COMPRESSION=off

OYL_INSTANCE_METRICS=off
# With metrics on: a random token of 32+ characters (`openssl rand -hex 32`),
# sent as `Authorization: Bearer <token>`. A secret, like the tunnel token.
OYL_INSTANCE_METRICS_TOKEN=

# The history index (#835): a searchable copy of each rider's synced history
# for the analysis, worked out by a model on THIS machine. To turn it on, set
# COMPOSE_PROFILES=history and the address below, then
# `docker compose up -d ollama` and
# `docker compose exec ollama ollama pull nomic-embed-text`. Empty: off.
COMPOSE_PROFILES=
OYL_INSTANCE_EMBEDDING_URL=
# Empty: nomic-embed-text and its own prefixes. Changing either re-embeds everything.
OYL_INSTANCE_EMBEDDING_MODEL=

# The analysis model (#1096): the post-ride write-up's agent, run by a model on
# THIS machine. Set COMPOSE_PROFILES=analysis (or history,analysis), then
# `docker compose up -d ollama` and `docker compose exec ollama ollama pull
# <a model you chose>` — this project recommends none, and the model must
# support tool calling. Then the address http://ollama:11434/v1 and the model's
# name below. Empty: off.
OYL_INSTANCE_ANALYSIS_MODEL_URL=
OYL_INSTANCE_ANALYSIS_MODEL=

# A hosted model key (#1097): the secret it is encrypted under, 32 bytes of
# base64 (`openssl rand -base64 32`). A SECRET: this file only, and kept away
# from OYL_BACKUP_DIR and OYL_OFFBOX_DIR — a snapshot and this together are
# the key. Empty: no hosted key can be set or read. The instance's own keys
# are wrapped under it too (#1189): empty, it makes none and offers no sealed
# routes; lost, every device pins again (docs/operating-an-instance.md).
OYL_INSTANCE_SECRET_KEY=
# The operator's device key (64 hex characters): the moderator, and the
# athlete a hosted key is held for. `model-key set` needs it.
OYL_INSTANCE_OWNER_KEY=

# The token the Cloudflare dashboard gives the tunnel. A SECRET: this file
# only, never a commit, never a log.
CLOUDFLARE_TUNNEL_TOKEN=

# Snapshots on this machine, and their copy off it (a USB drive, a share).
OYL_BACKUP_DIR=C:/onyourleft/backups
OYL_OFFBOX_DIR=E:/onyourleft-backups
OYL_BACKUP_KEEP=14
OYL_BACKUP_INTERVAL_SECONDS=21600
