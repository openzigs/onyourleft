# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to `.env` beside compose.yaml and fill in (#807). `.env` is ignored by
# git; this file is the template. Every name here is also in the repository's
# own .env.example, with what it means.

# The image deploy.sh built (it sets this itself; for a hand-run compose, the
# tag you built).
OYL_INSTANCE_IMAGE=onyourleft-instance:local

# The tunnel's public hostname, as a rider's app will use it.
OYL_INSTANCE_ORIGIN=https://rides.example.org

# `open` while the riders you expect sign up, then `closed`.
OYL_INSTANCE_REGISTRATION=closed

# Empty: one room worker per core.
OYL_INSTANCE_ROOM_WORKERS=

# `off` (the default, ruling Q16) or `on`. On a home connection whose UPLOAD
# is the limit, `on` roughly doubles the rooms it carries at twice the memory
# (docs/self-hosting/home-machine.md, "Compression").
OYL_INSTANCE_WS_COMPRESSION=off

OYL_INSTANCE_METRICS=off

# The token the Cloudflare dashboard gives the tunnel. A SECRET: this file
# only, never a commit, never a log.
CLOUDFLARE_TUNNEL_TOKEN=

# Snapshots on this machine, and their copy off it (a USB drive, a share).
OYL_BACKUP_DIR=C:/onyourleft/backups
OYL_OFFBOX_DIR=E:/onyourleft-backups
OYL_BACKUP_KEEP=14
OYL_BACKUP_INTERVAL_SECONDS=21600
