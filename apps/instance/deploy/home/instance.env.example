# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to `.env` beside compose.yaml and fill in (#807). This file is the
# template: keep it as it came, so the next release's copy shows what changed.
# docs/self-hosting/home-machine.md, step 4, says what each line is for.

# The image deploy.sh built (it sets this itself; for a hand-run compose, the
# tag you built).
OYL_INSTANCE_IMAGE=onyourleft-instance:local

# How riders reach the instance (#2805, ADR 0079): ONE remote path, never two
# (docs/self-hosting/home-machine.md, step 3). Change all four together.
#
#   The owner's tailnet (no domain), the default here:
#     COMPOSE_PROFILES=tailscale, OYL_INSTANCE_REMOTE_PATH=tailnet (or funnel),
#     OYL_INSTANCE_CLIENT_ADDRESS_HEADER=x-forwarded-for, and the origin
#     https://<TAILSCALE_HOSTNAME>.<your tailnet>.ts.net
#   A Cloudflare tunnel (a domain you own):
#     COMPOSE_PROFILES=cloudflare, OYL_INSTANCE_REMOTE_PATH=cloudflare,
#     OYL_INSTANCE_CLIENT_ADDRESS_HEADER=cf-connecting-ip, and the origin
#     https:// and the tunnel's public hostname
#
# Add `history` or `analysis` to COMPOSE_PROFILES with a comma for those below.
COMPOSE_PROFILES=tailscale
OYL_INSTANCE_REMOTE_PATH=tailnet
OYL_INSTANCE_CLIENT_ADDRESS_HEADER=x-forwarded-for
# The instance's one address, as a rider's app will use it. REPLACE the
# example: put your own tailnet's name where `your-tailnet` is, or your
# tunnel's hostname. While it is the example the instance serves no account,
# and its setup page only says to set this (#2855).
OYL_INSTANCE_ORIGIN=https://onyourleft.your-tailnet.ts.net

# The tailnet only. The machine's name on the tailnet: empty is `onyourleft`.
# It is PUBLIC (Certificate Transparency logs), so not your name or street.
TAILSCALE_HOSTNAME=
# The tailnet only, optional: an auth key tagged tag:onyourleft. A SECRET, like
# the tunnel token. Empty: the first deploy prints a sign-in link instead.
TAILSCALE_AUTH_KEY=

# The name the app shows for this instance, at most 64 characters. Empty: none.
OYL_INSTANCE_NAME=

# The legal and contact page, /legal (#908). OYL_INSTANCE_CONTACT_EMAIL is
# REQUIRED (#2857): nothing starts without it. An email address YOU read: the
# page tells your riders, and anybody with a complaint about what is on your
# server, to write to it. It is empty here on purpose, so that no server
# names somebody else. Name yourself as the accountable person.
# Public rooms (#788) stay off until the owner has made the check in
# docs/self-hosting/home-machine.md, "Public rooms: the owner's check"; on
# refuses to start without both of the first two.
OYL_INSTANCE_CONTACT_EMAIL=
OYL_INSTANCE_ACCOUNTABLE_PERSON=
OYL_INSTANCE_PRIVACY_POLICY_URL=https://github.com/openzigs/onyourleft/blob/main/docs/privacy-policy.md
OYL_INSTANCE_PUBLIC_ROOMS=off

# The terms of service (#909). Empty until the owner approves
# docs/moderation/terms-of-service.md; then mount it into the container and
# name it here, with the date it takes effect.
OYL_INSTANCE_TERMS_FILE=
OYL_INSTANCE_TERMS_VERSION=

# Leave it empty on a fresh install: the setup page asks, and what you choose
# there wins over this line (#2859). Empty means `approval`: each new account
# waits for you to approve it. `invite`, `closed` or `open` otherwise.
OYL_INSTANCE_REGISTRATION=

# Empty: one room worker per core.
OYL_INSTANCE_ROOM_WORKERS=

# `off` (the default, ruling Q16) or `on`. On a home connection whose UPLOAD
# is the limit, `on` roughly doubles the rooms it carries at twice the memory
# (docs/self-hosting/home-machine.md, "Compression").
OYL_INSTANCE_WS_COMPRESSION=off

OYL_INSTANCE_METRICS=off
# With metrics on: a random token of 32+ characters, sent as
# `Authorization: Bearer <token>`. A secret, like the tunnel token. Empty, the
# instance makes one on its first start in secrets/metrics-token (#2781);
# `openssl rand -hex 32` here is optional, for an existing install.
OYL_INSTANCE_METRICS_TOKEN=

# The instance's own admin pages at /admin (#2641, ADR 0069): `off` (the
# default) or `on`. On, the owner signs in with a one-time code from
# `docker compose exec instance node src/operator/cli.ts admin-code`; they
# need OYL_INSTANCE_SECRET_KEY and OYL_INSTANCE_OWNER_KEY too
# (docs/operating-an-instance.md, "Admin pages").
OYL_INSTANCE_ADMIN_PAGES=off

# The admin pages on THIS machine, at http://localhost:8788 (#2643), and the
# first-run setup at http://localhost:8788/setup (#2784): empty is 8788.
# compose.yaml publishes it on 127.0.0.1 only. A passkey made there is for
# localhost, not for the tunnel's address, and the reverse
# (docs/operating-an-instance.md).
OYL_INSTANCE_ADMIN_LOOPBACK_PORT=

# Optional: the only addresses an admin sign-in THROUGH THE TUNNEL is taken
# from (#2643), commas between — your home IP. Off when empty, the default:
# the WAF rule (docs/self-hosting/home-machine.md, step 5) is what keeps others
# out, and listing it here too locks you out twice when your address changes.
OYL_INSTANCE_ADMIN_ADDRESSES=

# The tunnel's readiness, for Status in the app's Operate area (#2604). The
# `tunnel` service serves cloudflared's metrics on `tunnel_metrics`, a network
# only it and the instance are on, never on the host. Its fixed address there
# (compose.yaml), not its name, which resolves on both of its networks.
# Empty: the app shows the tunnel as "not known". compose.yaml trusts the
# client-address header from this address as well as 172.30.87.10, so the
# rate limits hold whichever network cloudflared's requests arrive on.
OYL_INSTANCE_TUNNEL_READY_URL=http://172.30.88.10:20241/ready

# The history index (#835): a searchable copy of each rider's synced history
# for the analysis, worked out by a model on THIS machine. To turn it on, add
# history to COMPOSE_PROFILES above and set the address below, then
# `docker compose up -d ollama` and
# `docker compose exec ollama ollama pull nomic-embed-text`. Empty: off.
# An https: address must be an IP address, not a name (#1248).
OYL_INSTANCE_EMBEDDING_URL=
# Empty: nomic-embed-text and its own prefixes. Changing either re-embeds everything.
OYL_INSTANCE_EMBEDDING_MODEL=

# The analysis model (#1096): the post-ride write-up's agent, run by a model on
# THIS machine. Add analysis to COMPOSE_PROFILES above, then
# `docker compose up -d ollama` and `docker compose exec ollama ollama pull
# <a model you chose>` — this project recommends none, and the model must
# support tool calling. Then the address http://ollama:11434/v1 and the model's
# name below. Empty: off.
OYL_INSTANCE_ANALYSIS_MODEL_URL=
OYL_INSTANCE_ANALYSIS_MODEL=
# Optional (#1268): a model that reasons before it answers spends part of each
# turn thinking. Say so with the tokens a turn may spend on it, 1 to 16384 (for
# example 3072), and every turn is given that room beside the answer's own
# 1024. Empty: the instance finds out from the model's replies.
OYL_INSTANCE_ANALYSIS_MODEL_REASONING_TOKENS=
# Optional (#2840): the context, tokens, the model is loaded with — the
# `ollama` service below is given the same number, so the two agree. A
# write-up that would not fit is stopped with a reason instead of losing its
# start silently. Empty: 16384. An Ollama outside this file (on the machine
# itself) needs its own OLLAMA_CONTEXT_LENGTH set to this number.
OYL_INSTANCE_ANALYSIS_MODEL_CONTEXT_TOKENS=
# Optional (#1106): a model on the same Ollama that takes PICTURES, for a rider
# who switches on sending their side camera's pictures here instead of having
# their tablet look at them. `docker compose exec ollama ollama pull <a model
# you chose that reads images>`, then its name below. A picture is shown to it
# and not kept: not in the database, a file or a log. Empty: none, and a rider
# who asks is told so. The analysis model above is never used for pictures.
OYL_INSTANCE_PICTURE_MODEL=

# A hosted model key (#1097): the secret it is encrypted under, 32 bytes of
# base64. LEAVE IT EMPTY on a new install (#2781): the instance makes it on
# its first start in secrets/instance-secret-key beside compose.yaml, and
# reads it there after. Setting it here (`openssl rand -base64 32`) is
# optional, for an existing install, and wins. A SECRET: this file only, and kept away
# from OYL_BACKUP_DIR and OYL_OFFBOX_DIR — a snapshot and this together are
# the key. Empty: no hosted key can be set or read. The instance's own keys
# are wrapped under it too (#1189): empty, it makes none and offers no sealed
# routes; lost, every device pins again (docs/operating-an-instance.md).
OYL_INSTANCE_SECRET_KEY=
# The operator's device key (64 hex characters): the moderator, and the
# athlete a hosted key is held for. `model-key set` needs it.
OYL_INSTANCE_OWNER_KEY=
# A second moderator's device key. Leave it empty: an instance has one
# moderator (#905, docs/moderation.md), and empty means there is no deputy.
OYL_INSTANCE_DEPUTY_KEY=

# Voice on Discord (#874, #2146): empty both and there is no voice. The bot's
# token is NOT in this file: put it alone in `secrets/discord-bot-token` beside
# compose.yaml (mode 600; on Linux owned by uid 1000, the image's user) and set
# the path below as it is INSIDE the container. The server's id is not a secret.
OYL_INSTANCE_DISCORD_BOT_TOKEN_FILE=
# OYL_INSTANCE_DISCORD_BOT_TOKEN_FILE=/run/secrets/onyourleft/discord-bot-token
OYL_INSTANCE_DISCORD_GUILD_ID=

# The Cloudflare tunnel only: the token the Cloudflare dashboard gives it. A
# SECRET: this file only, never a commit, never a log.
CLOUDFLARE_TUNNEL_TOKEN=

# Snapshots on this machine, and their copy off it. Both REQUIRED: the deploy
# refuses to start without them. On Windows a USB stick does not work as the
# off-box folder (docs/self-hosting/home-machine.md, "Backups").
# No backup may be older than 30 days (#1381): OYL_BACKUP_KEEP times
# OYL_BACKUP_INTERVAL_SECONDS must stay under 2592000.
OYL_BACKUP_DIR=C:/onyourleft/backups
OYL_OFFBOX_DIR=E:/onyourleft-backups
OYL_BACKUP_KEEP=14
OYL_BACKUP_INTERVAL_SECONDS=21600
