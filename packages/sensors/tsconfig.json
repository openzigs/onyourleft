{
  // The whole package: `src/` (the transport-agnostic abstraction and the
  // simulator), `web-bluetooth/` (#40's adapter) and this package's Vitest
  // config.
  //
  // `lib: ["ES2024", "DOM"]` here and NOT in tsconfig.platform-free.json is the
  // point of having two files, for exactly the reason packages/fit has two.
  // ESLint's project service resolves a file to the nearest `tsconfig.json`, so
  // this is the config that has to cover every file in the package or lint
  // reports "not found by the project service" instead of anything useful. The
  // narrower program below is what actually enforces the boundary, and
  // `pnpm run typecheck` runs both.
  //
  // `types: ["web-bluetooth"]` is types-only, MIT, and has no dependencies. It
  // is here so that `gatt-conformance.test.ts` can assert that the real
  // `Bluetooth`, `BluetoothDevice`, `BluetoothRemoteGATTServer`,
  // `BluetoothRemoteGATTService` and `BluetoothRemoteGATTCharacteristic` are
  // each assignable to the port `web-bluetooth/src/gatt.ts` declares. A
  // hand-written port that drifts from the browser API is otherwise a bug that
  // only shows up on somebody's trainer.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["web-bluetooth"]
  },
  "include": ["src/**/*.ts", "protocol/**/*.ts", "web-bluetooth/**/*.ts", "vitest.config.ts"]
}
