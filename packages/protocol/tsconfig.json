{
  // `lib` is ES2024 and nothing else, and `types` is empty — packages/domain's
  // and packages/physics' closure, for the reason docs/agents/lint-boundaries.md §4d gives: the
  // same bytes are decoded in a browser, in the Android WebView and in a room
  // (`apps/instance`, under Node or `workerd`), so nothing here may name a
  // platform. With `types: []`, `WebSocket`, `fetch`, `TextEncoder`, `process`
  // and `Buffer` are all compile errors — which is why the decoder measures
  // UTF-8 length by hand rather than with a `TextEncoder`.
  //
  // One program, not two: unlike packages/fit and packages/sensors there is no
  // authoring-time directory that needs a wider library, so the main tsconfig
  // IS the one that enforces. The closure is conditional on nothing here
  // pulling `/// <reference types="node" />` back in, which is why
  // `vitest.config.ts` imports nothing (docs/agents/lint-boundaries.md §4d).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": []
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
