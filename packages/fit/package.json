{
  "name": "@onyourleft/fit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "FIT / GPX / TCX codec: the FIT activity file decoder and encoder, GPX 1.1 and TCX v2 import and export, the synthetic fixture corpus and its generator, and the ADR 0004 decision G region guard.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.platform-free.json",
    "test": "vitest run",
    "fixtures:generate": "node --import ./tools/ts-extensionless-resolve.mjs tools/fixture-corpus/generate.ts"
  },
  "dependencies": {
    "@onyourleft/domain": "workspace:*"
  },
  "devDependencies": {
    "fit-file-parser": "5.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
