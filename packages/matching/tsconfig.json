{
  // The whole package: `src/` (the prototype) plus `tools/` (the corpus
  // generator and the measurement harness) plus this package's Vitest config.
  //
  // Two tsconfigs for `packages/fit`'s reason, and it matters more here than
  // usual: the harness has to READ A CLOCK to report a measurement, and the
  // prototype must not. `types: ["node"]` lives here and not in
  // tsconfig.platform-free.json, so `performance.now()` compiles in `tools/`
  // and is a compile error in `src/`. ESLint's project service resolves a file
  // to the nearest `tsconfig.json`, so this one has to cover every file in the
  // package or lint reports "not found by the project service".
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "vitest.config.ts"]
}
